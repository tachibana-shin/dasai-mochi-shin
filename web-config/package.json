{
  "name": "web-config",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "latest",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "vite": "^8.0.14",
    "vue-tsc": "^3.3.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && bun -e \"const fs=require('fs'),p=require('path');const d=p.resolve(__dirname,'../data');if(fs.existsSync(d))fs.rmSync(d,{recursive:true,force:true});fs.cpSync(p.resolve(__dirname,'dist'),d,{recursive:true});\"",
    "preview": "vite preview",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src"
  },
  "dependencies": {
    "@primevue/themes": "^4.5.4",
    "@vueuse/core": "^14.3.0",
    "autoprefixer": "^10.5.0",
    "filesize": "^11.0.17",
    "lucide-vue-next": "^0.577.0",
    "postcss": "^8.5.15",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "tailwindcss": "^4.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vue": "^3.5.34",
    "vue-i18n": "^9.14.5"
  }
}
